# Copier ce fichier en .env puis renseigner les valeurs réelles.
# .env est ignoré par git (voir .gitignore) : ne jamais committer de
# vraies valeurs, y compris ici.

# --- Cœur Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Domaine racine de la plateforme (utilisé par CORS et la résolution de
# tenant depuis le sous-domaine, ex: moncampus.civitasnews.example)
MAIN_DOMAIN=civitasnews.example

# --- Base de données (format URL, lu par dj-database-url) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Google Sign-In (optionnel : GoogleAuthView répond 503 si absent) ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Stockage des fichiers médias (images, avatars, documents, audio/vidéo) ---
# Le disque de Render est ÉPHÉMÈRE : sans l'une des deux options
# ci-dessous, tout fichier uploadé est perdu au prochain déploiement.
# Cloudinary est PRIORITAIRE sur S3 si les deux sont renseignées.
#
# Option A (recommandée) -- Cloudinary : un seul identifiant à définir.
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Option B -- S3 ou équivalent compatible S3 (Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces...). Ignorée si CLOUDINARY_URL est renseignée.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=eu-west-3
# Laisser vide pour AWS S3 lui-même ; renseigner pour un équivalent S3.
AWS_S3_ENDPOINT_URL=
# Domaine personnalisé (CDN devant le bucket), optionnel.
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
